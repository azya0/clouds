const float regressor_0_biases[32] = { -0.054941657930612564, 0.029090244323015213, -0.006172674708068371, 0.03168818727135658, -0.04014210030436516, -0.00869298167526722, -0.032227471470832825, -0.07277661561965942, -0.03686557710170746, -0.06302144378423691, -0.055717144161462784, 0.058448221534490585, -0.06634778529405594, -0.021142104640603065, -0.024314118549227715, -0.047689467668533325, -0.03750535100698471, -0.020162668079137802, 0.06361262500286102, -0.03831816464662552, 0.07922684401273727, -0.024808919057250023, -0.01649785041809082, -0.05188633129000664, -0.022219635546207428, -0.035581301897764206, -0.016245901584625244, -0.046516045928001404, -0.017951034009456635, -0.052386004477739334, -0.04019321873784065, -0.011091572232544422 };
// 1 x 32
const float regressor_2[32] = { -0.01610792987048626, 0.10464712977409363, 0.00642983615398407, 0.06856036186218262, -0.016304412856698036, 0.011301190592348576, -0.024006662890315056, 0.018862111493945122, -0.0027711568400263786, -0.00565429637208581, -0.0028243795968592167, -0.03944835066795349, 0.011435167863965034, -0.010735943913459778, -0.005228653084486723, 0.00819630641490221, 0.0019165126141160727, 0.0007371160900220275, 0.06049436703324318, 0.01857929863035679, -0.027026714757084846, -0.0021969815716147423, 0.03425657004117966, 0.0033196399454027414, 0.010556714609265327, -0.01652701199054718, 0.02023203857243061, -0.009824676439166069, 0.0008200688171200454, 0.004650026094168425, -0.02198651246726513, 0.03582195192575455 };
const float regressor_2_biases = 0.008150901645421982;


float[64] shared_0_layer(float[6] base_vector) {
	float[64] result_vector;
	
	for (int index = 0; index < 64; index++) {
		result_vector[index] = 0.0;
	}
	
	for (int row_index = 0; row_index < 64; row_index++) {
		for (int index = 0; index < 6; index++) {
			int matrix_index = row_index * 64 + index;
			result_vector[index] += base_vector[index] * shader_0[matrix_index];
		}
		
		result_vector[row_index] += shared_0_biases[row_index];
	}
	
	// RELU
	for (int index = 0; index < 64; index++) {
		result_vector[index] = max(0.0, result_vector[index]);
	}
	
	return result_vector;
}


float[32] shared_3_layer(float[64] base_vector) {
	float[32] result_vector;
	
	for (int index = 0; index < 32; index++) {
		result_vector[index] = 0.0;
	}
	
	for (int row_index = 0; row_index < 32; row_index++) {
		for (int index = 0; index < 64; index++) {
			int matrix_index = row_index * 32 + index;
			result_vector[index] += base_vector[index] * shared_3[matrix_index];
		}
		
		result_vector[row_index] += shared_3_biases[row_index];
	}
	
	for (int index = 0; index < 32; index++) {
		result_vector[index] = max(0.0, result_vector[index]);
	}
	
	return result_vector;
}

float[32] regressor_0_layer(float[32] base_vector) {
	float[32] result_vector;
	
	for (int index = 0; index < 32; index++) {
		result_vector[index] = 0.0;
	}
	
	for (int row_index = 0; row_index < 32; row_index++) {
		for (int index = 0; index < 32; index++) {
			int matrix_index = row_index * 32 + index;
			result_vector[index] += base_vector[index] * regressor_0[matrix_index];
		}
		
		result_vector[row_index] += regressor_0_biases[row_index];
	}
	
	for (int index = 0; index < 32; index++) {
		result_vector[index] = max(0.0, result_vector[index]);
	}
	
	return result_vector;
}

float regressor_2_layer(float[32] base_vector) {
	float result = 0.0;
	
	for (int index = 0; index < 32; index++) {
		result += base_vector[index] * shader_0[index];
	}
	
	result += regressor_2_biases;
	
	return result;
}


float cast_ray_to_sun(vec3 position, float current_time) {
	vec3 direction = -normalize(light_direction);
	vec3 end_point = get_sphere_intersection(position, direction);
	
	float[6] input = { 
		position.x, position.y, position.z,
		end_point.x, end_point.y, end_point.z
	};
	
	float[64] first_layer = shared_0_layer(input);
	float[32] second_layer = shared_3_layer(first_layer);
	float[32] third_layer = regressor_0_layer(second_layer);
	
	return regressor_2_layer(third_layer);
}

uniform float percentage_troposphere = 0.25;

vec4 raymarching(vec3 direction) {
	float step_size = percentage_troposphere / float(steps);
	vec3 position = (1. - percentage_troposphere) * direction;
	vec3 addition = direction * step_size;

	vec3 color = vec3(0.);
	float transmittance = 1.;

	float cos_teta = max(0, dot(direction, normalize(light_direction)));
	
	float phase1 = phase_impact_1 * phase_function(cos_teta, phase_const_1);
	float phase2 = phase_impact_2 * phase_function(cos_teta, phase_const_2);
	
	float current_time = 0.0;

	for (int index = 0; index < steps; index++) {
		vec3 local_position = to_01(position);
		
		float density = get_density(local_position, current_time) * step_size;
		float sun_density = cast_ray_to_sun(position, current_time);

		position += addition;
		
		float sun_impact = exp(-sun_constant * sun_density);
		
		float density_impact = density_constant * density;

		float light = (phase1 + phase2) * sun_impact * density_impact;

		color += sunlight_color * light * transmittance;
		transmittance *= exp(-sun_constant * density);
	}

	vec4 result = vec4(color, 1.0 - transmittance);

	// Add phase function impact
	//result *= phase_function();

	return result;
}


void sky() {
	if (EYEDIR.y >= 0.0) {
		vec3 direction = EYEDIR;
		
		vec4 result = raymarching(direction);
		COLOR = result.rgb;
	}
}
