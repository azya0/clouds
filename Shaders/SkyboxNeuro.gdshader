			first_layer_vector[row_index] += base_vector[index] * shared_classifier_0[matrix_index];
		}
		
		first_layer_vector[row_index] += shared_classifier_0_biases[row_index];
	}
	
	// RELU
	for (int index = 0; index < 64; index++) {
		first_layer_vector[index] = max(0.0, first_layer_vector[index]);
	}
	
	float[32] second_layer_vector;
	
	for (int index = 0; index < 32; index++) {
		second_layer_vector[index] = 0.0;
	}
	
	for (int row_index = 0; row_index < 32; row_index++) {
		for (int index = 0; index < 64; index++) {
			int matrix_index = row_index * 64 + index;
			second_layer_vector[row_index] += first_layer_vector[index] * shared_classifier_3[matrix_index];
		}
		
		second_layer_vector[row_index] += shared_classifier_3_biases[row_index];
	}
	
	for (int index = 0; index < 32; index++) {
		second_layer_vector[index] = max(0.0, second_layer_vector[index]);
	}
	
	float result = 0.0;
	
	for (int index = 0; index < 32; index++) {
		result += second_layer_vector[index] * classifier[index];
	}
	
	result += classifier_biases;
	
	return result;
}

